{
  "name": "@subzerodev/service-contract",
  "version": "0.3.0",
  "type": "module",
  "description": "The projected wire contract between SubZeroDev products that run as separate processes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Running-Dev/SubZeroDev.ServiceContract.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/generate-contract.ts && tsx scripts/generate-content-contract.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@the-running-dev/game-engine": "file:./vendor/the-running-dev-game-engine-0.6.0.tgz",
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ts-json-schema-generator": "^2.3.0",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
